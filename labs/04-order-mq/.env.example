# 实验四本地配置占位符；请复制为 .env 后填写，不要提交真实凭据。
MYSQL_DATABASE=order_mq
MYSQL_USERNAME=order_mq
MYSQL_PASSWORD=<请填写本地数据库密码>
MYSQL_ROOT_PASSWORD=<请填写本地 root 密码>
MYSQL_PORT=3310
DB_URL=jdbc:mysql://localhost:3310/order_mq
DB_USERNAME=order_mq
DB_PASSWORD=<请填写本地数据库密码>
RABBITMQ_USERNAME=order_mq
RABBITMQ_PASSWORD=<请填写本地 RabbitMQ 密码>
RABBITMQ_PORT=5672
