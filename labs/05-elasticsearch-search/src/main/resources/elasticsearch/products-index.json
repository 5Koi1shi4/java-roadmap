{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "productId": { "type": "long" },
      "sourceVersion": { "type": "long" },
      "name": { "type": "text", "analyzer": "smartcn", "fields": { "raw": { "type": "keyword" } } },
      "subtitle": { "type": "text", "analyzer": "smartcn" },
      "description": { "type": "text", "analyzer": "smartcn" },
      "categoryCode": { "type": "keyword" },
      "categoryName": { "type": "keyword", "fields": { "text": { "type": "text", "analyzer": "smartcn" } } },
      "price": { "type": "scaled_float", "scaling_factor": 100 },
      "status": { "type": "keyword" },
      "createdAt": { "type": "date" },
      "updatedAt": { "type": "date" }
    }
  }
}
