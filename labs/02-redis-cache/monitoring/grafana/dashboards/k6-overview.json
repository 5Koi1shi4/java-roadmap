{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(k6_http_reqs_total{testid=~\"${testid:regex}\"}[1m]))", "legendFormat": "requests/s", "refId": "A"}],
      "title": "请求速率",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "100 * avg(k6_http_req_failed_rate{testid=~\"${testid:regex}\"})", "legendFormat": "failure rate", "refId": "A"}],
      "title": "失败率",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "k6_http_req_duration_p95{testid=~\"${testid:regex}\"}", "legendFormat": "P95", "refId": "A"}],
      "title": "P95 延迟",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "max(k6_vus_max{testid=~\"${testid:regex}\"})", "legendFormat": "allocated VUs", "refId": "A"}],
      "title": "已分配 VU",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 41,
  "tags": ["k6"],
  "templating": {
    "list": [
      {
        "datasource": "Prometheus",
        "allValue": ".*",
        "includeAll": true,
        "label": "testid",
        "multi": true,
        "name": "testid",
        "query": "label_values(k6_http_reqs_total, testid)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "k6 概览",
  "uid": "k6-overview",
  "version": 1
}
