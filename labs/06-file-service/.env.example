DB_PASSWORD=replace-me
DB_ROOT_PASSWORD=replace-me
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
# 宿主机运行应用时通过本机映射端口访问 Toxiproxy；容器内部使用 http://toxiproxy:8666。
MINIO_ENDPOINT=http://localhost:8666
MINIO_BUCKET=secure-files
MINIO_REGION=us-east-1
MINIO_CONNECT_TIMEOUT=5s
MINIO_READ_TIMEOUT=30s
MINIO_WRITE_TIMEOUT=30s
