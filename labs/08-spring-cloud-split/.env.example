# 复制为 .env 后替换所有 <replace-me>；不要提交 .env 或密钥文件。
MYSQL_ROOT_PASSWORD=<replace-me>
IDENTITY_APP_PASSWORD=<replace-me>
IDENTITY_MIGRATOR_PASSWORD=<replace-me>
MARKET_APP_PASSWORD=<replace-me>
MARKET_MIGRATOR_PASSWORD=<replace-me>

RABBITMQ_DEFAULT_USER=<replace-me>
RABBITMQ_DEFAULT_PASS=<replace-me>
MINIO_ROOT_USER=<replace-me>
MINIO_ROOT_PASSWORD=<replace-me>

CAMPUS_MARKET_IDENTITY_VERIFICATION_SECRET=<replace-me>
CAMPUS_MARKET_PAYMENT_SIGNING_SECRET=<replace-me>
CAMPUS_MARKET_SMTP_HOST=<replace-me>
CAMPUS_MARKET_SMTP_PORT=<replace-me>
CAMPUS_MARKET_SMTP_USERNAME=<replace-me>
CAMPUS_MARKET_SMTP_PASSWORD=<replace-me>
CAMPUS_MARKET_SMTP_FROM=<replace-me>
# 固定契约值：issuer 使用本地约定值，audience 必须为 campus-market-api。
CAMPUS_MARKET_JWT_ISSUER=<replace-me>
CAMPUS_MARKET_JWT_AUDIENCE=<replace-me>

# 使用仓库外的 RS256 PKCS#8 私钥和 X.509 公钥文件；填写本机绝对路径。
JWT_PRIVATE_KEY_FILE=<replace-me>
JWT_PUBLIC_KEY_FILE=<replace-me>
