# Copy this file to .env and replace every value before starting MySQL.
MYSQL_PORT=3307
MYSQL_DATABASE=security_rbac
MYSQL_USER=security_app
MYSQL_PASSWORD=replace-with-a-local-development-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password

# Export this value to the application process before running Spring Boot.
# It must be Base64-encoded and decode to at least 32 random bytes.
JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
